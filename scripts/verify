#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository_root"

uv sync --all-extras --dev --locked
uv run ruff check .
uv run ruff format --check .
uv run mypy
uv run python -m pytest \
  --cov=his_mon \
  --cov-report=term-missing \
  --cov-fail-under=90

rm -rf build dist his_monitoring.egg-info
uv build
